# ============================================================
# 环境变量模板
# 复制为 .env 后填写真实值：
#   cp .env.example .env
# .env 已被 .gitignore 排除，切勿提交到仓库！
# ============================================================

# 阿里云百炼（DashScope）API Key —— 必须
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 自定义网关地址（可选；默认使用官方 https://dashscope.aliyuncs.com）
DASHSCOPE_BASE_URL=

# MinerU 文档解析服务 Token（可选，仅 PDF→Markdown 阶段需要）
# 获取地址：https://mineru.net/user/info
MINERU_TOKEN=

# 全局 Token 预算（官方限制 5,000,000）
TOKEN_BUDGET=5000000
